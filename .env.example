# Frontend environment variables (Vite — must be prefixed with VITE_)

# API base URL used by the browser
# Dev default: /api (proxied to local backend)
# Prod: Render API (backend BASE_URL + /api)
# VITE_API_URL=https://travel-package-builder-node.onrender.com/api
VITE_API_URL=/api

# Dev only — where Vite proxies /api requests (not used in production build)
VITE_API_PROXY_TARGET=http://localhost:3001
